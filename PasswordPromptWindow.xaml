<Window x:Class="RKSwitch.SynDrvCl.PasswordPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Přihlášení k Synology" Icon="Assets/rk-switch.ico"
        Width="580" Height="570" MinWidth="540" MinHeight="530"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="#F3F6FA" ShowInTaskbar="False">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="První uložení hesla" FontSize="24" FontWeight="SemiBold" Foreground="#183153"/>
      <TextBlock Text="Heslo lze bezpečně uložit do Správce přihlašovacích údajů Windows a potom už přepínat jedním kliknutím."
                 Foreground="#59697D" TextWrapping="Wrap" Margin="0,5,0,0"/>
    </StackPanel>
    <Border Grid.Row="1" Background="#FFF7E7" BorderBrush="#FFD277" BorderThickness="1" CornerRadius="9" Padding="14" Margin="0,18,0,0">
      <StackPanel>
        <TextBlock Text="CÍLOVÁ ADRESA" FontSize="10" FontWeight="SemiBold" Foreground="#7A4D00"/>
        <TextBlock x:Name="TargetText" FontSize="20" FontWeight="SemiBold" Foreground="#183153" Margin="0,3,0,0"/>
        <TextBlock x:Name="TransferText" Foreground="#7A4D00" TextWrapping="Wrap" Margin="0,10,0,0"/>
      </StackPanel>
    </Border>
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,18,0,0">
      <StackPanel Margin="0,0,6,0">
        <TextBlock Text="Heslo účtu DSM" FontWeight="SemiBold" Foreground="#183153"/>
        <Border Background="White" BorderBrush="#AEBCCD" BorderThickness="1" CornerRadius="8" Margin="0,7,0,0">
          <PasswordBox x:Name="PasswordInput" Padding="12,10" BorderThickness="0" FontSize="16"
                       PasswordChanged="PasswordInput_PasswordChanged" KeyDown="PasswordInput_KeyDown"/>
        </Border>
        <TextBlock Text="Uživatelský účet, SSL a synchronizační úlohy zůstanou beze změny. Případné varování certifikátu musíte posoudit ručně."
                   Foreground="#59697D" TextWrapping="Wrap" Margin="0,12,0,0"/>
        <CheckBox x:Name="SavePasswordCheckBox" Content="Uložit heslo do Správce přihlašovacích údajů Windows"
                  IsChecked="True" Margin="0,14,0,6"/>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="3" BorderBrush="#D8E2EE" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="0,16,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Zrušit" Padding="22,10" IsCancel="True" Click="Cancel_Click"/>
      <Button x:Name="ContinueButton" Content="Uložit a přepnout" Padding="22,10" Margin="10,0,0,0"
              Background="#09A7BE" BorderBrush="#07899C" Foreground="White" FontWeight="SemiBold"
              IsEnabled="False" IsDefault="True" Click="Continue_Click"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
