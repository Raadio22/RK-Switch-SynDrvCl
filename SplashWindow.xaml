<Window x:Class="RKSwitch.SynDrvCl.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="560" Height="330" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False" Topmost="True">
  <Border CornerRadius="20" BorderBrush="#26B7C9" BorderThickness="1" Background="#0B2B4C">
    <Border.Effect>
      <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.34" Color="#07192C"/>
    </Border.Effect>
    <Grid Margin="34">
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Width="132" Height="132" CornerRadius="66" Background="#123B61" VerticalAlignment="Center" HorizontalAlignment="Left">
          <Image Source="Assets/rk-switch.png" Width="112" Height="112" RenderOptions.BitmapScalingMode="HighQuality"/>
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
          <TextBlock Text="RK-Switch" Foreground="White" FontSize="35" FontWeight="SemiBold"/>
          <TextBlock Text="Synology Drive Client" Foreground="#BFD0E8" FontSize="16" Margin="0,5,0,0"/>
          <Border Height="1" Background="#3F6A8F" Margin="0,18,0,16"/>
          <TextBlock Text="Připravuji bezpečné přepínání…" Foreground="#DCEAF5" FontSize="13"/>
          <TextBlock Text="Načítám aktuální stav Synology Drive" Foreground="#8FB2D8" FontSize="11" Margin="0,5,0,0"/>
        </StackPanel>
      </Grid>
      <Grid Grid.Row="1" Margin="0,22,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <ProgressBar Height="5" IsIndeterminate="True" Foreground="#09A7BE" Background="#173F62" BorderThickness="0" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" Text="verze 0.6.0" Foreground="#829DBD" FontSize="10" Margin="18,0,0,0" VerticalAlignment="Center"/>
      </Grid>
    </Grid>
  </Border>
</Window>
