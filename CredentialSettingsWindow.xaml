<Window x:Class="RKSwitch.SynDrvCl.CredentialSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Správa hesla Synology" Icon="Assets/rk-switch.ico"
        Width="540" Height="365" MinWidth="500" MinHeight="340"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="#F3F6FA" ShowInTaskbar="False">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Heslo pro automatické přepnutí" FontSize="23" FontWeight="SemiBold" Foreground="#183153"/>
      <TextBlock Text="Heslo chrání Správce přihlašovacích údajů Windows pro váš aktuální účet. Aplikace je nikdy nezapisuje do konfigurace ani logu."
                 Foreground="#59697D" TextWrapping="Wrap" Margin="0,6,0,0"/>
    </StackPanel>
    <Border Grid.Row="1" Background="#E6F8FA" BorderBrush="#9DDCE5" BorderThickness="1" CornerRadius="9" Padding="13" Margin="0,18,0,0">
      <TextBlock x:Name="CredentialStateText" Foreground="#183153" FontWeight="SemiBold"/>
    </Border>
    <StackPanel Grid.Row="2" Margin="0,18,0,0">
      <TextBlock Text="Nové heslo účtu DSM" FontWeight="SemiBold" Foreground="#183153"/>
      <Border Background="White" BorderBrush="#AEBCCD" BorderThickness="1" CornerRadius="8" Margin="0,7,0,0">
        <PasswordBox x:Name="PasswordInput" Padding="12,10" BorderThickness="0" FontSize="16"
                     PasswordChanged="PasswordInput_PasswordChanged"/>
      </Border>
      <TextBlock Text="Uživatelské jméno zůstává uložené v Synology Drive; RK-Switch je nemění."
                 Foreground="#59697D" TextWrapping="Wrap" Margin="0,10,0,0"/>
    </StackPanel>
    <Grid Grid.Row="3" Margin="0,20,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Button x:Name="DeleteButton" Content="Smazat uložené heslo" Padding="16,10" HorizontalAlignment="Left" Click="Delete_Click"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button Content="Zavřít" Padding="20,10" IsCancel="True"/>
        <Button x:Name="SaveButton" Content="Uložit heslo" Padding="20,10" Margin="10,0,0,0"
                Background="#09A7BE" BorderBrush="#07899C" Foreground="White" FontWeight="SemiBold"
                IsEnabled="False" IsDefault="True" Click="Save_Click"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
